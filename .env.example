# Local development only. Replace both placeholders before starting Compose.
POSTGRES_DB=parking_dev
POSTGRES_USER=parking_local
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
API_DATABASE_URL=host=db port=5432 dbname=parking_dev user=parking_local password=REPLACE_WITH_LOCAL_RANDOM_PASSWORD connect_timeout=3
OIDC_CLIENT_SECRET=REPLACE_WITH_RANDOM_CLIENT_SECRET
OIDC_ADMIN_USER=parking-setup-admin
OIDC_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
SMTP_SENDER=REPLACE_WITH_YOUR_GMAIL_ADDRESS
OPS_METRICS_TOKEN=REPLACE_WITH_RANDOM_METRICS_TOKEN
OIDC_DRIVER_ADMIN_SECRET=REPLACE_WITH_RANDOM_DRIVER_SERVICE_SECRET
REQUIRE_STAFF_MFA=false
# Retained test services are declared in compose.test.yaml; never remove them as orphans.
COMPOSE_IGNORE_ORPHANS=true
